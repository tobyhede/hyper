// use prisma-next

types {
  Uuid = String @db.Uuid
}

model Space {
  id               Uuid     @id @default(dbgenerated("gen_random_uuid()"))
  document         Json
  revision         String   @default("0")
  exportedRevision String?  @map("exported_revision")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        temporal.updatedAt() @map("updated_at")
  resources        Resource[]
  repositoryStates RepositoryState[]

  @@map("spaces")
}

model RepositoryState {
  singletonId Int  @id @default(1) @map("singleton_id")
  metaSpaceId Uuid @map("meta_space_id")
  metaSpace   Space @relation(fields: [metaSpaceId], references: [id], onDelete: Restrict)

  @@map("repository_state")
}

model Resource {
  id        Uuid     @id @default(dbgenerated("gen_random_uuid()"))
  spaceId   Uuid     @map("space_id")
  document  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@map("resources")
}
