// The Mounting deployment (ADR 0130): `pnpm build:mount`'s static build served
// by Workers static assets, with no Worker script. Workers Builds runs
// `scripts/cloudflare-build.sh` as its build command; the build variable
// VITE_HYPER_DEFAULT_SOURCE names the GitHub location the bare domain opens.
// How to deploy, and point a domain at a talk: docs/deploy-cloudflare.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hyper",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./packages/app/dist-mount",
    // Every product URL loads the application, and an unknown one is answered
    // by its "not found" destination rather than an HTTP 404 (ADR 0130).
    "not_found_handling": "single-page-application",
  },
  // A branch other than the production one deploys as a Preview.
  "previews": {},
}
