{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {},
  // Mirrors eslint.config.js's top-level `ignores` array (a separate list —
  // ESLint's flat config and Oxlint's JSON config can't share one literal).
  // Update both when a new generated/vendor path needs excluding.
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-http/**",
    "packages/app/build/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/coverage/**",
    "**/.tanstack/**",
    "**/.scratch/**",
    "**/.serena/**",
    "**/.claude/**",
    "**/.agents/**",
    "**/.worktrees/**",
    "**/src/prisma/contract.d.ts",
    "**/migrations/**/end-contract.d.ts",
    "**/migrations/**/start-contract.d.ts",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "rules": {
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error"
  }
}
