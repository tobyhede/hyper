{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {},
  // Mirrors eslint.config.js's top-level `ignores` array (a separate list —
  // ESLint's flat config and Oxlint's JSON config can't share one literal).
  // Update both when a new generated/vendor path needs excluding.
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-http/**",
    "packages/app/build/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/coverage/**",
    "**/.tanstack/**",
    ".stryker-tmp/**",
    "reports/**",
    "**/.scratch/**",
    "**/.serena/**",
    "**/.claude/**",
    "**/.agents/**",
    "**/.worktrees/**",
    "**/src/prisma/contract.d.ts",
    "**/migrations/**/end-contract.d.ts",
    "**/migrations/**/start-contract.d.ts",
    "tools/oxlint/anti-slop/**",
    "tools/typing-fixtures/**"
  ],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "rules": {
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    // `allowInTypeGuards` exempts a `typeof` check inside a function whose own
    // return type is a type predicate (`x is Y`) — the check IS that predicate's
    // narrowing logic, not a bypass of it (e.g. `observable-state.ts`'s
    // `isThenable`). Discovered while migrating this rule in issue 04; see that
    // ticket's resolution for the before/after count.
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }]
  },
  // Scoped exceptions from .scratch/anti-slop/issues/02-migrate-boundary-decoders.md
  // and 03-migrate-bounded-rules.md — see .scratch/anti-slop/spec.md for which
  // rule each override waits on before it goes live repo-wide.
  "overrides": [
    {
      // The Postgres repository's own boundary code: classifying caught driver
      // errors (`error: unknown` is the caught-exception case, structurally the
      // same as the rule's own exempted `cause` parameter) and coercing
      // `number | string | bigint` wire/DB revisions, where `typeof` discriminates
      // an already-closed union rather than narrowing untyped external input.
      "files": ["src/persistence/postgres-space-repository.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-runtime-typeof": "off",
        // toDatabaseRevision's `value as unknown as number`: bigint and number
        // have no direct assertion path, and a real `Number(value)` call could
        // lose precision above Number.MAX_SAFE_INTEGER — see the SAFETY comment
        // on that function for the full rationale.
        "anti-slop/no-chained-type-assertions": "off"
      }
    },
    {
      // The HTTP wire-protocol codec: every decode*/exactRecord function here
      // IS the I/O boundary parser the rule asks callers to run before calling
      // in — their `value: unknown` parameters and typeof/dictionary checks are
      // the boundary itself, not a missing one. exactRecord's generic
      // `Record<string, unknown>` is a runtime key-set check parameterized by a
      // caller-supplied key list, so it cannot be narrowed to a named shape.
      "files": ["packages/persistence/src/http-protocol.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // `.shape` is Zod's own public `ZodObject` API for reading a schema's field
      // schemas back out — not a symbol either test declares, so there is nothing
      // to rename. Both files read it to keep an assertion honest against the
      // schema itself rather than a hand-copied literal (see each file's own
      // docstring for why the duplication would be worse than the exception).
      "files": [
        "packages/core/test/card-document-equality.test.ts",
        "test/unit/postgres-import-decoding.test.ts"
      ],
      "rules": {
        "anti-slop/no-shape-in-symbol-names": "off"
      }
    },
    {
      // Base UI and React Flow are vendored third-party UI libraries this repo
      // does not own. Each of these mocks the primitive/component boundary so
      // the test observes delegation — that the wrapper renders the *installed*
      // import — without asserting the vendor's own private DOM or requiring
      // its full runtime context (React Flow's store/provider tree). There is
      // no in-repo real implementation of either library to inject instead;
      // the boundary itself is the seam, same as `no-runtime-typeof`'s
      // postgres/http-protocol exceptions above but for a vendored render
      // dependency rather than a wire format.
      "files": [
        "packages/ui/test/Button.test.tsx",
        "packages/ui/test/AddCardControl-base-ui.test.tsx",
        "packages/react-flow-adapter/test/CardNode.test.tsx",
        "packages/react-flow-adapter/test/GraphHud.test.tsx",
        "packages/app/test/cameras.test.tsx"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "off"
      }
    },
    {
      // Design debt flagged rather than fixed (research.md: no-module-mocking
      // findings are design feedback, not free syntax fixes). This mocks
      // `node:fs/promises` to fault-inject ENOSPC/EPERM on specific paths so
      // export's cleanup-after-partial-failure paths are reachable at all —
      // real disk-full/permission-denied conditions aren't practically
      // triggerable in a test. Unlike the Base UI/React Flow boundary above,
      // a real fix exists in principle: give `exportSpace` an injected
      // filesystem seam (ADR 0016's composition-time pattern) so this test
      // could supply a faithful in-memory implementation that fails on
      // command. That is a production-code change this bounded, zero-prod-risk
      // phase deliberately does not make — left for whoever next touches
      // `src/export/export-space.ts`.
      "files": ["test/unit/export-space-recovery.test.ts"],
      "rules": {
        "anti-slop/no-module-mocking": "off"
      }
    },
    {
      // `graphColorMap` builds its map at runtime, keyed by however many graphs
      // a Space holds — there is no static literal for `satisfies` to check and
      // no narrower key type escapes the rule's own unconditional `Record<...>`
      // = "open dictionary" classification (see `tools/oxlint/anti-slop/shared/
      // dictionary-types.ts`'s `classifyWideningTarget`, which doesn't look at
      // the key type at all). Returning a `Map` instead would dodge the rule but
      // is an API change beyond a lint migration's scope.
      "files": ["packages/app/src/colors.ts"],
      "rules": {
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      // `LAYOUT_ONLY` is genuinely sparse: indexed by the full
      // `AuthoringCompletion['kind']` union at its one call site
      // (`LAYOUT_ONLY[completion.kind]`), it lists only the completion kinds
      // that need a Layout, not every kind that union has. `Partial<Record<...>>`
      // is what makes that indexing return `string | undefined` safely; a named
      // interface would have to enumerate every kind as optional, which
      // duplicates (and can drift from) the union instead of tracking it.
      // `sameValue`'s `typeof`/`Record<string, unknown>` are the same case
      // issue 02 excepted for `http-protocol.ts`'s `toJsonValue`: a genuinely
      // generic recursive JSON-value comparator, not unparsed external input —
      // both sides are already-validated snapshot values by the time this runs.
      "files": ["packages/app/src/space-authoring.ts"],
      "rules": {
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        // sameValue's `left`/`right: unknown` parameters are the same generic
        // recursive comparator case as the two rules above — nothing narrower
        // to accept when the whole point is comparing two arbitrary JSON values.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `defaultMarkdownKind`/`defaultPositionedKind` are Zod `z.preprocess`
      // transformers: they run on raw, unvalidated input *before* the schema
      // parses it, so `unknown` in and out is the honest contract, not a
      // narrowing that was skipped — the schema right after is where parsing
      // happens. Their `typeof value === 'object'` and `value: unknown`
      // parameter are that preprocessing step itself, the same boundary-parser
      // category issue 02 established for `http-protocol.ts`'s decode functions.
      "files": ["packages/core/src/schema.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `rule-fixture.ts` shells out to the real `oxlint` binary and parses its
      // JSON report — an external process's output with no declared type on
      // either side. `runOxlint`'s `unknown` return, `isOxlintReport`'s and
      // `isExecFileError`'s `unknown` parameters and `typeof` checks are that
      // boundary itself, the same category as `schema.ts`'s preprocessors above.
      "files": ["test/unit/anti-slop/rule-fixture.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // This file's whole job is loading a dynamically `import()`-ed module and
      // validating its shape before treating it as `SpaceHttpRuntime` —
      // `FetchApplication.fetch`'s `env`, `SpaceHttpRuntime.createApp`'s
      // `options`, `asRuntime`'s `loaded` parameter and its `typeof` checks,
      // and `runtimeOptions` are all that validation boundary or what a dynamic
      // import genuinely resolves to before anyone has looked at it — same
      // boundary-parser category as `schema.ts`'s preprocessors above. `Next`'s
      // `error?: unknown` mirrors Node/Connect middleware's own `next(err?)`
      // contract, a second, unrelated external contract in the same file.
      "files": ["packages/app/vite-space-http-plugin.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `@project/graph`'s one intake (`loadSpace`/`loadSpaceSnapshot`, ADR
      // 0010): `unsupportedDocumentVersion`, `retiredSpaceGraphs` and
      // `loadSpaceSnapshot` itself take and read a raw `unknown` document's
      // shape before (and to decide whether to reach) the Zod schema that
      // actually parses it. Same boundary-parser category as issue 02's two
      // excepted files — this is that same kind of code, just in
      // `@project/graph` instead of `@project/persistence`.
      "files": ["packages/graph/src/space.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `listeners: Set<() => unknown>` and the test double that mirrors it:
      // a subscriber's return value is inspected only to detect whether it's
      // thenable (`isThenable`, a real type guard — its own `typeof` checks are
      // already exempted by `allowInTypeGuards`, and its `value: unknown`
      // parameter is the type guard's own input by definition), never narrowed
      // into a domain type. The test's `_onFulfilled`/`onRejected: (reason:
      // unknown) => unknown` mirrors `PromiseLike.then`'s own lib.d.ts
      // signature, which is `unknown` for the same reason. `ObserverError
      // Reporter`'s `error: unknown` (this file's own error-reporting seam) is
      // the same case every file in the override below shares — grouped here
      // instead because this file already has other rules excepted.
      "files": [
        "packages/persistence/src/observable-state.ts",
        "packages/persistence/test/observable-state.test.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `typeof` used for JS-environment/platform feature detection
      // (`typeof window/document/Element !== 'undefined'`, `vitest.setup.ts`'s
      // whole reason for existing) or to discriminate a closed union or
      // optional-function property a library's own types declare (React Flow's
      // `nodeColor`, Node's `net.Server.address(): AddressInfo | string | null`
      // and `fs.writeFile`'s `PathLike` parameter, Vite's optional
      // `configureServer`/`configurePreviewServer` plugin hooks, an ESLint
      // `unknown` config result shape-checked once) — none of these are
      // unparsed *external* data the rule's "parse at the I/O boundary" message
      // has anywhere further to push to.
      "files": [
        "vitest.setup.ts",
        "packages/ui/src/components/sidebar.tsx",
        "packages/react-flow-adapter/test/GraphHud.test.tsx",
        "test/unit/raw-http-request.test.ts",
        "test/unit/vite-hono-host.test.ts",
        "test/unit/vite-space-http-plugin.test.ts",
        "test/unit/export-space-recovery.test.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // `typeof x` used to name a runtime type as the *value under test*
      // (`expect(typeof x).toBe('number')`) rather than to narrow or branch on
      // anything — there is nothing to parse ahead of an assertion that the
      // assertion itself is checking.
      "files": [
        "packages/react-flow-adapter/test/projection.test.ts",
        "test/unit/http-server-build-config.test.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // This test deliberately verifies ESLint's *actual runtime* resolved
      // config (`calculateConfigForFile`) rather than trusting `eslint`'s own
      // declared types — see the file's own docstring. `config`'s `typeof`
      // check and `rules`'s dictionary type are that boundary verification
      // itself: `rules` is genuinely keyed by an open-ended, ESLint-ecosystem-
      // wide set of rule names with a heterogeneous per-rule value shape
      // (`Severity | [Severity, ...unknown[]]`), so there is no honest
      // narrower type to give it. `isRestrictedImports` is that same
      // boundary's own runtime shape guard — its `value` parameter is
      // genuinely unparsed input from the same untyped resolved config.
      "files": ["test/unit/http-node-builtin-restrictions.test.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `spaceWith`'s `extra` parameter accepts raw, not-yet-validated
      // space-file fields that get spread into the object `loadSpace` parses
      // immediately after — the same boundary-parser category as
      // `schema.ts`'s preprocessors above. Both files' own fixture constants
      // are deliberately loosely typed (plain `string` ids/kind, not the
      // branded/literal `SpaceFile` shape) so that `loadSpace`'s own runtime
      // validation is what each test exercises, not a static type — retyping
      // `extra` to `Partial<SpaceFile>` breaks on exactly that mismatch.
      "files": [
        "packages/app/test/canvas-projection.test.ts",
        "packages/app/test/renderer.test.ts"
      ],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // `FrontmatterSchema.safeParse`'s `value: unknown` mirrors Zod's own
      // `ZodType.safeParse(data: unknown)` signature exactly — this interface
      // exists so a caller can hold "something Zod-safeParse-shaped" without
      // importing Zod's own types, so its parameter has to match Zod's, not a
      // narrower one. `describe`'s `error: unknown` is this file's own
      // error-reporting seam, the same case as the override below — kept here
      // rather than folded in because it shares a file with the genuine
      // external-contract case above.
      "files": ["packages/graph/src/card-file.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // This repo's error-reporting/error-describing seam, repeated across
      // many independent files: a function that receives whatever a `catch`
      // or a Promise rejection handed it and either logs it (`console.error`),
      // converts it to a display string, classifies it (`instanceof Error`,
      // a `.code` check), or — `elk-strategy.ts`'s `loadDefaultEngine` —
      // invalidates a cache keyed on the failure and re-throws the same value
      // unexamined. All are the same shape as `ObserverErrorReporter` above
      // and structurally identical to the rule's own exempted `cause`
      // parameter. JS lets `throw`/`reject` carry any value, so `unknown` is
      // the sound type for "whatever was thrown"; every one of these
      // functions does its own narrowing immediately where it narrows at all
      // (`error instanceof Error ? ... : ...`), which *is* the "parse before
      // use" step the rule's message asks for — there is no schema to run
      // first for an opaque caught value, and a pure re-throw needs no
      // narrowing to begin with. Renaming every one of these to the rule's
      // literal exempted name (`cause`) was considered and rejected: most of
      // them are the error being reported, not a wrapped cause, and inventing
      // a name to dodge a linter is worse than a scoped exception. Two are
      // genuine external contracts, not our own seam: `Workspace.tsx`'s
      // `getDerivedStateFromError` overrides React's own lifecycle method
      // signature, and `space-authoring.test.ts`'s
      // `AuthoringOptions`/`AuthoringExtras` mirror
      // `packages/app/src/space-authoring.ts`'s real
      // `SpaceAuthoringDependencies.reportObserverError` (ADR 0016's
      // composition-time injection seam).
      "files": [
        "packages/app/src/navigation.ts",
        "packages/app/src/placement-rendering.ts",
        "packages/app/src/startup.tsx",
        "packages/app/src/Workspace.tsx",
        "packages/app/src/WorkspaceSelection.tsx",
        "packages/app/test/render-adapter.test.ts",
        "packages/app/test/space-authoring.test.ts",
        "packages/http/src/index.ts",
        "packages/persistence/src/session.ts",
        "packages/react-flow-adapter/src/elk/elk-strategy.ts",
        "src/cli/main.ts",
        "src/cli/run.ts",
        "src/import/read-single-space.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // Each of these takes a deliberately raw or deliberately invalid value
      // and hands it straight to a real intake or schema this repo already
      // trusts to parse it: `open-workspace.ts`'s `spaceFile` goes straight
      // into `loadSpace` (the one intake, ADR 0010); the three test files
      // build a value and pass it to `loadSpace`, `importSpaces`, or
      // `decodeCommitRequest` specifically to exercise their refusal paths —
      // the same "deliberately loosely-typed fixture, so the real runtime
      // validation is what's under test" case as issue 04/05's `spaceWith`
      // exception. There is nothing to parse ahead of the parser itself.
      "files": [
        "packages/app/src/open-workspace.ts",
        "packages/core/test/persistence-schema.test.ts",
        "packages/react-flow-adapter/test/projection.test.ts",
        "test/unit/postgres-import-decoding.test.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `onReconnectStart`/`onReconnectEnd`'s `event`/`_type` parameters are
      // this file's own prop contract wired straight through to `<ReactFlow>`
      // (see `reactFlowProps.onReconnectStart` below), carrying whatever
      // internal event/handle-type value React Flow's reconnect gesture
      // passes — not part of React Flow's own published types, so there is no
      // named type to import for it. Both are unused at the one call site
      // that reads them (`_event`, `_type`), consistent with that.
      "files": ["packages/app/src/edge-authoring-react.tsx"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // `Middleware`'s `next(error?: unknown)` mirrors Node/Connect
      // middleware's own `next(err?)` contract exactly. `vite-space-http-
      // plugin.test.ts`'s `record`'s `reason: unknown` mirrors Node's own
      // `process.on('unhandledRejection', (reason, promise) => ...)` event
      // signature, another external contract this repo doesn't declare.
      "files": ["test/unit/vite-hono-host.test.ts", "test/unit/vite-space-http-plugin.test.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // ADR 0062's own gate tests. Both read tool output and repository-owned
      // JSON at a boundary and narrow it with type predicates — the same
      // category as `packages/persistence/src/http-protocol.ts` above, and the
      // same three exemptions. They cannot take the `JSON.parse(...) as T`
      // shortcut the older tests use, because `no-unsafe-type-assertion` now
      // bans it and a test proving the ratchet bites must not be the one file
      // evading it.
      "files": ["test/unit/typing-fixtures.test.ts", "test/unit/assertion-ratchet.test.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // The two parse boundaries the ADR 0061 toolchain check owns: a workspace
      // `package.json`, read to learn which binary its `typecheck` script
      // invokes, and `pnpm -r list --json`, read to learn which directories pnpm
      // enumerates. Both are decoded by a named type predicate returning a named
      // contract — `TypecheckingManifest` and `ListedWorkspace` — which is the
      // shape the other rules ask for, and neither needs `no-runtime-typeof` or
      // `no-unsafe-dictionary-type` off to get there.
      //
      // Only `no-unknown-parameters` is lifted, and only because a predicate that
      // decides whether untrusted JSON has a shape must accept it before it has
      // one. Narrower than the boundary exemption above on purpose: taking all
      // three here would buy nothing and hide the two rules these files pass.
      // `scripts/ui-catalog.ts` is the same category and joins it rather than
      // opening a fifth: it reads `packages/app/package.json` to learn the
      // `#components/*` subpath patterns a story's imports resolve through, and
      // reading them is the point — a second copy of that mapping kept in the
      // checker would be the thing that drifts. It decodes through the same
      // named predicate returning a named contract, and passes
      // `no-runtime-typeof` and `no-unsafe-dictionary-type` unaided.
      "files": [
        "scripts/check-typescript-toolchain.ts",
        "test/unit/check-typescript-toolchain.test.ts",
        "scripts/ui-catalog.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      // The `must-pass` typing fixtures (ADR 0062; see
      // `tools/typing-fixtures/README.md`). `unknown-at-parse-boundary.ts` is a
      // parse boundary and takes exactly the same three exemptions
      // `packages/persistence/src/http-protocol.ts` takes above, for the same
      // reason: its `value: unknown` parameters and its record inspection are
      // the boundary itself, not a missing one. A fixture claiming to prove a
      // genuine parse boundary survives has to be declared the way this
      // repository declares one, or it proves something else.
      //
      // `require-safety-comment-for-type-assertion` is deliberately NOT off
      // here: ADR 0062 left it untouched, and `broadening-to-unknown.ts`
      // carries its `SAFETY:` comment to show it still applies.
      //
      // Scoped to this one file, not the whole `must-pass` directory. The half's
      // job is to catch a rule over-reaching, and a fixture cannot catch a rule
      // that is off for it — so the exemption buys the parse-boundary fixture
      // and costs nothing on the other three, which still face every rule.
      "files": ["tools/typing-fixtures/must-pass/unknown-at-parse-boundary.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    }
  ]
}
