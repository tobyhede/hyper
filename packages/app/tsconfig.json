{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["react", "react-dom", "vite/client"],
    // `app` is the composition layer, so it may reach everything — the `paths`
    // below are the full set, restated rather than inherited so that adding a
    // package forces a deliberate decision here about who may see it.
    //
    // No `rootDir`: unlike the others this config's `include` spans `src`,
    // `e2e`, `example` and the two Vite files at the package root, which have no
    // common root but the package itself. Nothing is above `app` to escape to.
    "paths": {
      "@project/core": ["../core/src/index.ts"],
      "@project/graph": ["../graph/src/index.ts"],
      "@project/http": ["../http/src/index.ts"],
      "@project/persistence": ["../persistence/src/index.ts"],
      "@project/react-flow-adapter": ["../react-flow-adapter/src/index.ts"],
      "@project/ui": ["../ui/src/index.ts"],
      "@project/ui/MarkdownSourceEditor": ["../ui/src/MarkdownSourceEditor.tsx"]
    }
  },
  "include": [
    "src",
    "example",
    "e2e",
    "ladle-e2e",
    "stories",
    ".ladle/components.tsx",
    "vite.config.ts",
    "vite-space-http-plugin.ts",
    "http-server-build.config.ts",
    "ladle-vite.config.ts"
  ]
}
