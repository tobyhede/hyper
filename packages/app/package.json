{
  "name": "@project/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#src/entity-actions": "./src/entity-actions.tsx",
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode e2e-fixture --port 5175 --strictPort",
    "dev:roadmap": "vite --mode roadmap --port 5176 --strictPort",
    "http-server:build": "vite build --config http-server-build.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && pnpm http-server:build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "test": "vitest run --root ../.. packages/app/test",
    "dev:new": "vite --mode e2e-empty --port 5174 --strictPort"
  },
  "dependencies": {
    "@project/core": "workspace:*",
    "@project/graph": "workspace:*",
    "@project/http": "workspace:*",
    "@project/persistence": "workspace:*",
    "@project/react-flow-adapter": "workspace:*",
    "@project/ui": "workspace:*",
    "@xyflow/react": "12.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@hono/node-server": "2.0.12",
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
