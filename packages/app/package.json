{
  "name": "@project/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SPACE_DIR=fixture vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:new": "SPACE_DIR=.space vite --port 5174 --strictPort",
    "e2e:server": "SPACE_DIR=fixture SPACE_READ_ONLY=1 vite --port 5273 --strictPort",
    "e2e:server:new": "SPACE_DIR=.space vite --port 5274 --strictPort"
  },
  "dependencies": {
    "@project/core": "workspace:*",
    "@project/graph": "workspace:*",
    "@project/react-flow-adapter": "workspace:*",
    "@project/ui": "workspace:*",
    "@tanstack/react-router": "^1.87.0",
    "@xyflow/react": "^12.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
