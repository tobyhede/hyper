{
  "name": "graph-native-presentations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @project/app dev",
    "dev:fixture": "pnpm --filter @project/app dev:fixture",
    "dev:new": "pnpm --filter @project/app dev:new",
    "ladle": "pnpm --filter @project/app ladle",
    "ladle:build": "pnpm --filter @project/app ladle:build",
    "prebuild": "pnpm contract:emit",
    "build": "pnpm --filter @project/app build",
    "http-server:build": "pnpm --filter @project/app http-server:build",
    "contract:emit": "prisma-next contract emit",
    "contract:check": "pnpm contract:emit && git diff --exit-code -- src/prisma/contract.json src/prisma/contract.d.ts && prisma-next migration check --format json",
    "db:migrate": "prisma-next migrate",
    "hyper": "tsx src/cli/entry.ts",
    "postgres:up": "docker compose up -d --wait",
    "postgres:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:packages": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:fixture": "playwright test --project=chromium",
    "e2e:ladle": "playwright test --config playwright.ladle.config.ts",
    "e2e:postgres": "playwright test --config playwright.postgres.config.ts",
    "test:integration:postgres": "pnpm contract:emit && pnpm db:migrate && vitest run --config vitest.integration.config.ts",
    "verify": "pnpm typecheck && pnpm typecheck:packages && pnpm lint && pnpm format:check && pnpm test:coverage"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@prisma-next/adapter-postgres": "0.16.0",
    "@prisma-next/contract": "0.16.0",
    "@prisma-next/sql-contract": "0.16.0",
    "@prisma-next/target-postgres": "0.16.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^3.23.1",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma-next": "0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma-next/postgres": "0.16.0",
    "dotenv": "^17.4.2"
  }
}
