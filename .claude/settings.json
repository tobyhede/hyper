{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "additionalDirectories": [
      "/Users/tobyhede/psrc/hyper/.worktrees",
      "/Users/tobyhede/psrc/hyper/.claude/worktrees"
    ],
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm ui:catalog:check)",
      "Bash(git fetch *)",
      "Bash(cargo check *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reject-co-authored-by.sh"
          }
        ]
      }
    ]
  }
}
