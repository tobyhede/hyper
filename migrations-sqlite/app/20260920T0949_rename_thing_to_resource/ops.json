[
  {
    "id": "table.resources",
    "label": "Create table resources",
    "summary": "Creates table resources with required columns",
    "operationClass": "additive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "resources"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"resources\" does not exist",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "resources"
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"resources\"",
        "sql": "CREATE TABLE \"resources\" (\n  \"created_at\" TEXT NOT NULL DEFAULT (datetime('now')),\n  \"document\" TEXT NOT NULL,\n  \"id\" TEXT NOT NULL,\n  \"space_id\" TEXT NOT NULL,\n  \"updated_at\" TEXT NOT NULL,\n  PRIMARY KEY (\"id\"),\n  FOREIGN KEY (\"space_id\") REFERENCES \"spaces\" (\"id\") ON DELETE CASCADE\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"resources\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "resources"
        ]
      }
    ]
  },
