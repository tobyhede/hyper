        "params": [
          "index",
          "resources_space_id_idx"
        ]
      }
    ],
    "execute": [
      {
        "description": "create index \"resources_space_id_idx\"",
        "sql": "CREATE INDEX \"resources_space_id_idx\" ON \"resources\" (\"space_id\")"
