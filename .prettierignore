**/dist/**
**/dist-http/**
**/node_modules/**
**/playwright-report/**
**/test-results/**
**/.scratch/**
**/.serena/**
# Agent tooling. Prettier does honour `.gitignore`, so this is belt and braces
# — but `.claude/worktrees/` holds real git worktrees on other branches, and
# a formatter reaching into those is the same mistake ESLint was making.
**/.claude/**
**/.agents/**
pnpm-lock.yaml
**/*.md
**/coverage/**

# Prisma Next owns these deterministic emitted artifacts.
src/prisma/contract.json
src/prisma/contract.d.ts
migrations/**/*.json
migrations/**/*.d.ts

# Vendored anti-slop Oxlint plugin — third-party source at a pinned commit,
# not ours to reformat.
tools/oxlint/anti-slop/**

# ESLint owns this one and rewrites it on every `--prune-suppressions`, so
# formatting it here would just be undone on the next run — and it is never
# hand-edited in any case (ADR 0062).
eslint-suppressions.json

# Typing fixtures (ADR 0062). Half of them are meant to fail; they are excluded
# from lint and typecheck for that reason, and reformatting a fixture is the
# kind of incidental edit that could quietly change what it proves.
tools/typing-fixtures/**
