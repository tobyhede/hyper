          "resources_space_id_fkey",
          "public",
          "\"public\".\"resources\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"resources_space_id_fkey\"",
        "sql": "ALTER TABLE \"public\".\"resources\"\nADD CONSTRAINT \"resources_space_id_fkey\"\nFOREIGN KEY (\"space_id\")\nREFERENCES \"public\".\"spaces\" (\"id\")\nON DELETE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"resources_space_id_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
