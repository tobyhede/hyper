node_modules/
dist/
.DS_Store
coverage/
playwright-report/
test-results/
.tanstack/
*.log

# Local environment and credentials. Commit only the credential-free template.
.env
.env.*
!.env.example

# Agent tooling (installed skills / session dirs), not project source
.agents/
.claude/
skills-lock.json
.serena/
.worktrees/

# The markdown issue tracker under .scratch/ is tracked; spike harnesses,
# renders and generated data living alongside it are working files.
.scratch/**
!.scratch/**/
!.scratch/**/*.md

# Package-local spike harnesses: runnable code that proved something and was
# never meant to ship. What they proved belongs in a finding or an ADR, in
# words — a local prototype does not carry a second copy of the app around to
# re-demonstrate a negative. Also excluded from tsc, eslint and prettier.
#
# Ignoring one is not the same as being rid of it: the graph-editing harness sat
# here ignored, went stale against a rename, and broke the dev server, because
# Vite's dependency scanner reads every `.html` in the root and does not consult
# this file. Delete a harness when it has been written up — this pattern is for
# one that is still being used.
packages/*/.scratch/

# Where `pnpm dev:new` and the new-space e2e project put a space the app minted.
# `SPACE_DIR` may name a directory that does not exist yet — that is how a new
# space gets a home — and this is the throwaway one. Delete it to start over.
packages/app/.space/
