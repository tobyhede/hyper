node_modules/
dist/
packages/app/dist-http/
# `ladle build`'s static output — the surface inventory as a hostable site.
packages/app/build/
.DS_Store
coverage/
playwright-report/
test-results/
.tanstack/
*.log

# Local environment and credentials. Commit only the credential-free template.
.env
.env.*
!.env.example

# Agent tooling. Session dirs and local settings are not project source, but the
# installed skills ARE: an ordinary `git worktree add` populates only tracked
# files, so ignoring them left every worktree running agents without the
# grilling loop, tdd, domain-modeling and the rest. `.agents/skills/` is where
# Codex looks and holds the real files; `.claude/skills/` is where Claude Code
# looks and holds symlinks into it — tracking only one fixes only one harness.
# `skills-lock.json` rides along or the vendored copies have no recorded
# upstream revision. The parents are `/*` rather than `/` because git will not
# descend into an excluded directory, so a trailing-slash form cannot be negated.
.agents/*
!.agents/skills/
.claude/*
!.claude/skills/
.serena/
.worktrees/

# The markdown issue tracker under .scratch/ is tracked; spike harnesses,
# renders and generated data living alongside it are working files.
.scratch/**
!.scratch/**/
!.scratch/**/*.md

# Package-local spike harnesses: runnable code that proved something and was
# never meant to ship. What they proved belongs in a finding or an ADR, in
# words — a local prototype does not carry a second copy of the app around to
# re-demonstrate a negative. Also excluded from tsc, eslint and prettier.
#
# Ignoring one is not the same as being rid of it: the graph-editing harness sat
# here ignored, went stale against a rename, and broke the dev server, because
# Vite's dependency scanner reads every `.html` in the root and does not consult
# this file. Delete a harness when it has been written up — this pattern is for
# one that is still being used.
packages/*/.scratch/

# Local import scratch space left by earlier prototype increments. `pnpm
# dev:new` explicitly ignores it and always mints a fresh memory workspace.
packages/app/.space/

# Derived from `.oxlintrc.json` by `test/unit/typing-fixtures.test.ts` for the
# length of one run, so the fixtures can be linted at all. Ignored so a crashed
# run cannot leave it to be committed.
.oxlintrc.typing-fixtures.json
